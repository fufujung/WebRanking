# Where the API server runs
API_URL=http://localhost:4000
# An API key with scope "admin" (created by `npm run setup`). Only used on the server, never sent to browsers.
API_KEY=
# Password for the /admin pages
ADMIN_PASSWORD=
# Random string used to sign the admin login cookie
SESSION_SECRET=
# Public address of the API (for the docs link in the footer). Defaults to API_URL.
PUBLIC_API_URL=
# Secret address of the admin login page, e.g. admin-3f9c2a7b1d opens it at /admin-3f9c2a7b1d.
# When set, /admin answers "not found" to anyone not logged in. Leave empty to log in at /admin/login.
ADMIN_PATH=
# "Log in with Discord" for players (optional). From https://discord.com/developers/applications → your app → OAuth2.
# Add <PUBLIC_SITE_URL>/api/auth/discord/callback under OAuth2 → Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public address of the website, e.g. https://therankingovertime.com (used for the Discord redirect).
PUBLIC_SITE_URL=
