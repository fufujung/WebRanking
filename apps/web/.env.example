# Where the API server runs
API_URL=http://localhost:4000
# An API key with scope "admin" (created by `npm run setup`). Only used on the server, never sent to browsers.
API_KEY=
# Password for the /admin pages
ADMIN_PASSWORD=
# Random string used to sign the admin login cookie
SESSION_SECRET=
# Public address of the API (for the docs link in the footer). Defaults to API_URL.
PUBLIC_API_URL=
