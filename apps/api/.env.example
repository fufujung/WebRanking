DATABASE_URL="file:./dev.db"
PORT=4000
# Comma-separated list of origins allowed to call the API from a browser (your other websites)
CORS_ORIGINS="http://localhost:3000"
# Optional. Scoreboard screenshots are read by a free built-in reader; with a key, Claude reads them instead
# (better on small or blurry pictures). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Which Claude model reads the screenshots. Empty = claude-haiku-5-5 (lowest cost).
# If it misreads your scoreboards, try claude-sonnet-5-5 or claude-opus-5-5 (better, costs more).
ANTHROPIC_MODEL=""
