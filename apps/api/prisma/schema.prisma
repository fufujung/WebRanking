generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A game the site runs tournaments for. Players, teams and tournaments belong to one game, so MMR and rankings are per game.
model Game {
  id        String   @id @default(cuid())
  name      String   @unique
  /// In-game ranks, lowest first, as JSON [{ name, iconUrl }]. Players pick one when signing up alone.
  ranks     String   @default("[]")
  createdAt DateTime @default(now())

  players     Player[]
  teams       Team[]
  tournaments Tournament[]
  guilds      Guild[]
}

/// A competing team. Teams play matches and carry an Elo rating.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String?
  logoUrl   String?
  country   String?
  rating    Int      @default(1000)
  gameId    String?
  /// The player who leads the team: can invite, kick and hand over the lead from the website.
  captainId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  invite TeamInvite?

  players    Player[]
  entries    TournamentEntry[]
  matchesAsA Match[]           @relation("TeamA")
  matchesAsB Match[]           @relation("TeamB")
  matchesWon Match[]           @relation("Winner")
  statLines  MatchPlayerStat[]

  @@index([gameId])
}

/// The secret code in a team's invite link. Kept apart from Team so team lists never show it.
model TeamInvite {
  teamId    String   @id
  code      String   @unique
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

/// A player. The in-game UID (+ server) identifies the same person across name changes.
model Player {
  id        String   @id @default(cuid())
  name      String
  nickname  String?
  country   String?
  role      String?
  avatarUrl String?
  teamId    String?
  uid       String? // in-game UID; one player per UID + server
  server    String? // in-game server
  discordId String? // Discord account that logged in on the website as this player (one account may play several characters)
  mmr       Int      @default(1000) // personal rating, replayed from every series the player appeared in
  peakMmr   Int      @default(1000)
  /// The separate rating of the special "เล่นเก่งปากเก่ง" events (tournaments with special = true).
  specialMmr     Int @default(1000)
  specialPeakMmr Int @default(1000)
  gameId    String? // the game this character plays; MMR and ranks are per game
  guildId   String? // the guild (club) this character belongs to, separate from the team it plays for
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  game         Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)
  guild        Guild?            @relation(fields: [guildId], references: [id], onDelete: SetNull)
  guildInvites GuildInvite[]
  statLines    MatchPlayerStat[]
  rosters      RosterPlayer[]
  soloSignups  SoloSignup[]
  names        PlayerName[]
  mmrLog       PlayerMmrChange[]
  blacklist    BlacklistEntry[]
  reserve      ReservePlayer?

  @@index([teamId])
  @@index([uid])
  @@index([discordId])
  @@index([gameId])
  @@index([guildId])
}

/// A name a player has used before, so old scoreboards and searches still find them.
model PlayerName {
  id        String   @id @default(cuid())
  playerId  String
  name      String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, name])
}

/// How one series moved one player's MMR. Rewritten whenever ratings are replayed.
model PlayerMmrChange {
  id       String @id @default(cuid())
  playerId String
  matchId  String
  before   Int
  delta    Int
  result   String // W | L | D for this player's side

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchId])
  @@index([matchId])
}

model Tournament {
  id          String    @id @default(cuid())
  name        String
  game        String? // the game's name, kept for API clients that read it
  gameId      String?
  location    String?
  description String?
  status      String    @default("UPCOMING") // UPCOMING | ONGOING | COMPLETED
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Bracket settings. format null = a free-form event where results are recorded without a bracket.
  format           String? // SINGLE_ELIMINATION | DOUBLE_ELIMINATION | ROUND_ROBIN
  bestOf           Int     @default(3)
  finalBestOf      Int? // best of for the final (grand final in double elimination); null = same as bestOf
  lateMinutes      Int     @default(15) // how late a team may check in before the other team can claim a walkover
  rosterMin        Int     @default(3)
  rosterMax        Int     @default(5)
  maxTeams         Int?
  registrationOpen Boolean @default(false)
  thirdPlaceMatch  Boolean @default(false) // single elimination only
  grandFinalReset  Boolean @default(true) // double elimination: a second final if the losers-bracket team wins the first
  bracketStatus    String  @default("NONE") // NONE | DRAFT (seeded, not started) | LIVE | DONE

  /// TEAM = teams sign up; SOLO = players sign up alone and the organizer draws them into teams.
  entryMode String @default("TEAM")
  /// A special "เล่นเก่งปากเก่ง" event: its results move the separate special MMR and stats, never the main ranking.
  special   Boolean @default(false)
  /// Players per drawn team (SOLO).
  teamSize  Int    @default(3)

  entries        TournamentEntry[]
  matches        Match[]
  bracketMatches BracketMatch[]
  soloSignups    SoloSignup[]
  blacklist      BlacklistEntry[]
  gameRef        Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([gameId])
}

model TournamentEntry {
  id               String         @id @default(cuid())
  tournamentId     String
  teamId           String
  placement        Int?
  seed             Int? // bracket order chosen when seeding (1 = top seed)
  captainDiscordId String? // only this Discord user may change the roster from Discord
  memberDiscordIds String         @default("[]") // JSON array: other Discord accounts of the team, let into match rooms
  createdAt        DateTime       @default(now())
  tournament       Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team             Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roster           RosterPlayer[]

  @@unique([tournamentId, teamId])
}

/// A player signed up alone for a SOLO tournament, with the position they play and their in-game rank.
model SoloSignup {
  id           String   @id @default(cuid())
  tournamentId String
  playerId     String
  discordId    String?
  position     String // GUARD | FORWARD | CENTER | ALL (All Around)
  rank         String // the name of one of the game's ranks
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
}

/// A standing substitute for the special "เล่นเก่งปากเก่ง" events. The list is always open and serves every event.
/// Facebook and phone are private: only admins and organizers see them.
model ReservePlayer {
  id        String   @id @default(cuid())
  playerId  String   @unique
  discordId String? // one sign-up per Discord account in each game (the list is kept per game)
  position  String? // GUARD | FORWARD | CENTER | ALL; null only for sign-ups carried over from the old Discord list
  rank      String? // in-game rank, used by the random draws in Discord
  facebook  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([discordId])
}

/// A player registered to play for a team in one tournament.
model RosterPlayer {
  id        String  @id @default(cuid())
  entryId   String
  playerId  String
  discordId String?
  uid       String? // in-game UID
  server    String? // in-game server
  order     Int     @default(0)

  entry  TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  player Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([entryId, playerId])
}

/**
 * One match slot in a tournament bracket. Slots exist before their teams are known;
 * winners and losers move along winnerTo / loserTo. A played slot links to the Match
 * that holds its games and player stats.
 */
model BracketMatch {
  id           String    @id @default(cuid())
  tournamentId String
  code         String // stable key within the tournament, e.g. W1-0, L2-1, GF1, P3, R3-2
  stage        String // W (winners / single elimination) | L (losers) | GF (grand final) | P3 (third place) | RR (round robin)
  round        Int
  position     Int
  number       Int // match number shown to people (M1, M2, ...)
  teamAId      String?
  teamBId      String?
  byeA         Boolean   @default(false)
  byeB         Boolean   @default(false)
  winnerTo     String? // code of the slot the winner moves to
  winnerSide   String? // A | B
  loserTo      String?
  loserSide    String?
  status       String    @default("PENDING") // PENDING (waiting for teams) | READY | DONE | SKIPPED
  outcome      String? // PLAYED | WALKOVER | BYE
  winnerId     String?
  loserId      String?
  scoreA       Int?
  scoreB       Int?
  matchId      String?   @unique
  scheduledAt  DateTime?
  checkInA     DateTime?
  checkInB     DateTime?
  disputed     Boolean   @default(false)
  disputeNote  String?
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, code])
  @@index([tournamentId])
}

/// A series between two teams (e.g. best of 3). scoreA/scoreB are games won.
model Match {
  id           String   @id @default(cuid())
  tournamentId String
  round        String?
  teamAId      String
  teamBId      String
  scoreA       Int
  scoreB       Int
  winnerId     String? // null = draw
  ratingDeltaA Int      @default(0)
  ratingDeltaB Int      @default(0)
  imageUrl     String? // optional extra evidence; per-game screenshots live on MatchGame
  notes        String?
  source       String? // where the result came from, e.g. "discord"
  sourceRef    String?  @unique // e.g. the Discord message id, so a post is never recorded twice
  playedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  tournament  Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA       Team              @relation("TeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB       Team              @relation("TeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  winner      Team?             @relation("Winner", fields: [winnerId], references: [id], onDelete: Cascade)
  games       MatchGame[]
  playerStats MatchPlayerStat[]
  bracketSlot BracketMatch?
  mmrChanges  PlayerMmrChange[]

  @@index([playedAt])
}

/// One game of a series, with its own scoreboard and screenshot.
model MatchGame {
  id       String  @id @default(cuid())
  matchId  String
  number   Int
  scoreA   Int
  scoreB   Int
  imageUrl String?

  match       Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerStats MatchPlayerStat[]

  @@unique([matchId, number])
}

/// One player's line on one game's scoreboard.
model MatchPlayerStat {
  id       String  @id @default(cuid())
  matchId  String
  gameId   String
  playerId String
  teamId   String
  pts      Int     @default(0)
  reb      Int     @default(0)
  blk      Int     @default(0)
  stl      Int     @default(0)
  ast      Int     @default(0)
  lbr      Int     @default(0)
  rating   Float? // the in-game rating shown under the player's badge, e.g. 16.9
  award    String? // MVP | SVP

  match  Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  game   MatchGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@index([playerId])
  @@index([matchId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String    @unique
  scope      String    @default("read") // read | admin
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

/// An advert for the organizer's own shop, shown on the public site.
model Ad {
  id             String    @id @default(cuid())
  title          String
  placement      String // banner | card | popup
  imageUrl       String
  /// Optional narrower image for phones (banner only).
  mobileImageUrl String?
  linkUrl        String
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  clicks         Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([placement])
}

/// A club players belong to outside of tournament teams. Only its leader invites; organizers can change the leader and the size.
model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  tag         String?
  logoUrl     String?
  description String?
  gameId      String?
  leaderId    String?
  /// Most members the guild can hold; organizers can raise it.
  capacity    Int      @default(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game    Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)
  members Player[]
  invites GuildInvite[]

  @@index([gameId])
}

/// The leader invited this character; it joins when its owner accepts on "my profile".
model GuildInvite {
  id        String   @id @default(cuid())
  guildId   String
  playerId  String
  createdAt DateTime @default(now())

  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([guildId, playerId])
  @@index([playerId])
}

/**
 * A player on the blacklist. Added by itself for every player of a team that lost a bracket match
 * by walkover without checking in on time, or by an organizer. Each standing entry takes `penalty`
 * MMR (applied in the MMR replay at createdAt); lifting it gives the MMR back.
 */
model BlacklistEntry {
  id           String    @id @default(cuid())
  playerId     String
  tournamentId String?
  slotCode     String? // the bracket match the team lost by walkover (automatic entries)
  matchNumber  Int?
  teamName     String?
  source       String    @default("AUTO") // AUTO (walkover) | ADMIN
  reason       String
  penalty      Int       @default(20)
  createdAt    DateTime  @default(now())
  liftedAt     DateTime?
  liftNote     String?

  player     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, slotCode, playerId])
  @@index([playerId])
  @@index([createdAt])
}
