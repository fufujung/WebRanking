generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A competing team. Teams play matches and carry an Elo rating.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String?
  logoUrl   String?
  country   String?
  rating    Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players    Player[]
  entries    TournamentEntry[]
  matchesAsA Match[]           @relation("TeamA")
  matchesAsB Match[]           @relation("TeamB")
  matchesWon Match[]           @relation("Winner")
  statLines  MatchPlayerStat[]
}

model Player {
  id        String   @id @default(cuid())
  name      String
  nickname  String?
  country   String?
  role      String?
  avatarUrl String?
  teamId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  statLines MatchPlayerStat[]

  @@index([teamId])
}

model Tournament {
  id          String    @id @default(cuid())
  name        String
  game        String?
  location    String?
  description String?
  status      String    @default("UPCOMING") // UPCOMING | ONGOING | COMPLETED
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries TournamentEntry[]
  matches Match[]
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  teamId       String
  placement    Int?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

/// A series between two teams (e.g. best of 3). scoreA/scoreB are games won.
model Match {
  id           String   @id @default(cuid())
  tournamentId String
  round        String?
  teamAId      String
  teamBId      String
  scoreA       Int
  scoreB       Int
  winnerId     String? // null = draw
  ratingDeltaA Int      @default(0)
  ratingDeltaB Int      @default(0)
  imageUrl     String? // optional extra evidence; per-game screenshots live on MatchGame
  notes        String?
  source       String? // where the result came from, e.g. "discord"
  sourceRef    String?  @unique // e.g. the Discord message id, so a post is never recorded twice
  playedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  tournament  Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA       Team              @relation("TeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB       Team              @relation("TeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  winner      Team?             @relation("Winner", fields: [winnerId], references: [id], onDelete: Cascade)
  games       MatchGame[]
  playerStats MatchPlayerStat[]

  @@index([playedAt])
}

/// One game of a series, with its own scoreboard and screenshot.
model MatchGame {
  id       String  @id @default(cuid())
  matchId  String
  number   Int
  scoreA   Int
  scoreB   Int
  imageUrl String?

  match       Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerStats MatchPlayerStat[]

  @@unique([matchId, number])
}

/// One player's line on one game's scoreboard.
model MatchPlayerStat {
  id       String  @id @default(cuid())
  matchId  String
  gameId   String
  playerId String
  teamId   String
  pts      Int     @default(0)
  reb      Int     @default(0)
  blk      Int     @default(0)
  stl      Int     @default(0)
  ast      Int     @default(0)
  lbr      Int     @default(0)
  rating   Float? // the in-game rating shown under the player's badge, e.g. 16.9
  award    String? // MVP | SVP

  match  Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  game   MatchGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@index([playerId])
  @@index([matchId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String    @unique
  scope      String    @default("read") // read | admin
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}
